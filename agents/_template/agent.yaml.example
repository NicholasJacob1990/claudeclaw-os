# Agent configuration
# Copy this folder, rename it, and fill in your values.
#
# Then add your bot token to .env:
#   MYAGENT_BOT_TOKEN=1234567890:AAFxxxxxxx
#
# Start with:
#   npm start -- --agent myagent

name: My Agent
description: What this agent does

# The env var name in .env that holds this agent's Telegram bot token.
# Create a bot via @BotFather in Telegram, paste the token into .env.
telegram_bot_token_env: MYAGENT_BOT_TOKEN

# Runtime backend. Choose which CLI/SDK powers this agent:
#   claude       (default) Claude Agent SDK; skills/MCPs ~/.claude/
#   codex                  Codex CLI subprocess; ~/.codex/AGENTS.md + skills
#   gemini                 Gemini CLI subprocess; ~/.gemini/extensions
#   openai-sdk             @openai/agents in-process — HOSTED TOOLS:
#                          web_search_preview, file_search, code_interpreter
#                          (requer OPENAI_API_KEY no .env)
#   gemini-sdk             @google/genai in-process — Google Search grounding
#                          + code_execution + thinking config
#                          (requer GEMINI_API_KEY ou GOOGLE_API_KEY no .env)
#
# CLIs (codex/gemini) carregam skills/MCPs do user existentes em $HOME.
# SDKs (openai-sdk/gemini-sdk) dão hosted tools que CLIs não expõem mas
# NÃO carregam skills locais.
runtime: claude

# Default model. Options:
#   claude-* — claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
#   codex    — model alias is set in ~/.codex/config.toml; this field unused
#   gemini   — model selection via ~/.gemini settings; this field unused
# Users can override per-chat with /model in Telegram (claude only).
model: claude-sonnet-4-6

# Obsidian integration (optional).
# Assign folders from your vault so this agent auto-loads relevant context.
# obsidian:
#   vault: /path/to/your/obsidian/vault
#   folders:
#     - FolderA/
#     - FolderB/
#   read_only:
#     - Daily Notes/
